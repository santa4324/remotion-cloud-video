{
  "name": "remotion-cloud-video",
  "version": "1.0.0",
  "description": "Remotion video rendered on GitHub Actions",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts out",
    "render": "mkdir -p out && remotion render src/index.ts StackShieldVideo out/video.mp4"
  },
  "dependencies": {
    "remotion": "latest",
    "@remotion/cli": "latest",
    "@remotion/renderer": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "ts-node": "latest"
  }
}
